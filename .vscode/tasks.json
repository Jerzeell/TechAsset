{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ejecutar TechAsset",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/start.ps1"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Compilar backend",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/TechAsset.sln"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Compilar frontend",
      "type": "shell",
      "command": "npm.cmd run build",
      "options": {
        "cwd": "${workspaceFolder}/src/frontend"
      },
      "problemMatcher": []
    }
  ]
}